# Required: Gemini API key from aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Model selection (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# GitHub token for board tools (motions, content, issues)
GITHUB_TOKEN=ghp_...

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=https://rrroca-site.web.app,https://rrroca.org,https://www.rrroca.org

# Rate limiting
RATE_LIMIT_RPM=6
DAILY_LIMIT=200

# Cloud Run injects this automatically
PORT=8080
